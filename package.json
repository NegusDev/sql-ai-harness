{
  "name": "dbask",
  "version": "0.1.8",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dbask": "./dist/cli.js",
    "sql-ai-harness": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "sql-ai.example.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ask": "node dist/cli.js ask",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/runners/run-benchmark.ts",
    "prepack": "pnpm run build",
    "pack:check": "pnpm pack --dry-run"
  },
  "keywords": [
    "text-to-sql",
    "nl2sql",
    "sql",
    "mysql",
    "mariadb",
    "postgresql",
    "postgres",
    "ai-agent",
    "llm",
    "database",
    "cli",
    "typescript"
  ],
  "author": "NegusDev",
  "license": "ISC",
  "description": "Open-source, self-hostable Text-to-SQL harness: ask questions about your existing MySQL, MariaDB, or PostgreSQL database in plain language, with a CLI and TypeScript SDK. Bring your own model.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NegusDev/dbask.git"
  },
  "homepage": "https://github.com/NegusDev/dbask#readme",
  "bugs": {
    "url": "https://github.com/NegusDev/dbask/issues"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.87",
    "@ai-sdk/deepseek": "^3.0.81",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/groq": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.165",
    "dotenv": "^18.0.5",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
