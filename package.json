{
  "name": "sql-ai-harness",
  "version": "0.1.0",
  "private": false,
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ask": "node dist/cli.js ask",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/runners/run-benchmark.ts",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "sql",
    "ai",
    "agent",
    "database",
    "text-to-sql",
    "typescript"
  ],
  "author": "NegusDev",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.67",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.127",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "description": "A provider-independent TypeScript SQL AI harness for querying existing relational databases.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NegusDev/sql-ai-harness.git"
  },
  "homepage": "https://github.com/NegusDev/sql-ai-harness#readme",
  "bugs": {
    "url": "https://github.com/NegusDev/sql-ai-harness/issues"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sql-ai-harness": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
