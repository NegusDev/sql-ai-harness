# AI provider: openrouter | groq | google | cerebras | ollama | deepseek
AI_PROVIDER=openrouter
AI_MODEL=your-model-id

# Set the key for the selected provider only.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=

# Ollama-compatible OpenAI API endpoint (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional OpenRouter application metadata
AI_SITE_URL=
AI_SITE_NAME=dbask

# Database connection. DB_DRIVER: mysql (also MariaDB) or postgres.
# DB_PORT defaults to 3306 (mysql) / 5432 (postgres) when left empty.
# DB_SSL: disable | require | verify-full (hosted Postgres usually needs require)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_read_only_user
DB_PASSWORD=
DB_SSL=disable

# Safety and runtime limits
SQL_MAX_ROWS=500
SQL_QUERY_TIMEOUT_MS=10000
SQL_MAX_RESULT_BYTES=1048576
AGENT_MAX_STEPS=8
# off (default). on makes the agent submit a schema-checked query plan before any SQL runs.
# Slower (about +0.7 tool calls per question); useful when you want to see the agent's assumptions.
AGENT_QUERY_PLAN=off
SCHEMA_CACHE_TTL_MS=300000
