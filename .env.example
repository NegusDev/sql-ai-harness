# AI provider: openrouter | groq | google | cerebras | ollama
AI_PROVIDER=openrouter
AI_MODEL=your-model-id

# Set the key for the selected provider only.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
CEREBRAS_API_KEY=

# Ollama-compatible OpenAI API endpoint (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional OpenRouter application metadata
AI_SITE_URL=
AI_SITE_NAME=SQL AI Harness

# MySQL connection (the current CLI adapter supports MySQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_read_only_user
DB_PASSWORD=

# Safety and runtime limits
SQL_MAX_ROWS=500
SQL_QUERY_TIMEOUT_MS=10000
SQL_MAX_RESULT_BYTES=1048576
AGENT_MAX_STEPS=8
SCHEMA_CACHE_TTL_MS=300000
